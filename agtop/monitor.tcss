Screen {
    layout: vertical;
}

#main {
    layout: horizontal;
    height: 1fr;
}

#left {
    width: 54;
}

#right {
    width: 1fr;
    border: round $accent;
    padding: 0;
}

Screen.-narrow #left {
    width: 1fr;
}

Screen.-narrow #right {
    display: none;
}

ListView {
    height: 1fr;
    padding: 0 1;
}

ListItem {
    height: 5;
    border: solid $panel-lighten-2;
    padding: 0 1;
}

ListItem:hover {
    border: solid $accent;
}

ListItem.--highlight {
    border: double $success;
    background: $success-darken-3;
}

ListItem.waiting {
    background: $error-darken-3;
    border: solid $error;
}

ListItem.waiting.--highlight {
    background: $error-darken-2;
    border: double $error;
}

ListItem.working {
    border: solid $accent-darken-1;
}

ListItem.working.--highlight {
    border: double $accent;
    background: $accent-darken-3;
}

RichLog {
    height: 1fr;
    background: $surface;
    padding: 0 1;
    scrollbar-size: 1 1;
}

Footer {
    background: $panel;
}

Tree {
    height: 1fr;
    padding: 0 1;
}

Tree > .tree--guides {
    color: $panel-lighten-2;
}

Tree > .tree--guides-selected {
    color: $accent;
}

#agent-viz {
    height: 1fr;
    padding: 1;
    scrollbar-size: 1 1;
}

#agent-flow {
    height: auto;
    padding: 0 1;
}

#agent-timeline {
    height: auto;
    padding: 0 1;
}
